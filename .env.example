# ==============================================================================
# Configuration Plateforme Multi-Agents n8n & Bionic LLM
# ==============================================================================

# --- Configuration n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Paris
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_AI_ENABLED=true

# --- Configuration Sandbox d'Exécution (n8n AI Sandbox Service) ---
N8N_SANDBOX_VERSION=1.3.4
SANDBOX_PORT=5680
SANDBOX_API_KEYS=sandbox-secret-token
SANDBOX_RUNNER_REGISTRATION_TOKEN=runner-registration-token
SANDBOX_RUNNER_API_KEY=runner-api-key
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

# --- Configuration Microservice d'Outils Rust (bionic-agent-tools) ---
RUST_TOOLS_HOST=0.0.0.0
RUST_TOOLS_PORT=3000

# --- Configuration Recherche Web (SearXNG) ---
SEARXNG_PORT=8088
SEARXNG_SECRET=searxng-bionic-agent-secret-token
SEARXNG_INTERNAL_URL=http://searxng:8080

# --- Configuration Connexion Modèle Local (Bionic / LM Studio) ---
# Dans le conteneur Docker, Bionic sur l'hôte est accessible via host.docker.internal
BIONIC_BASE_URL=http://host.docker.internal:1234
# Clé API optionnelle si requise par votre passerelle (laisser dummy en local)
BIONIC_API_KEY=dummy-token-local
# Nom du modèle déclaré dans Bionic (ex: qwen/qwen3.8-27b ou qwen/qwen3.5-9b)
BIONIC_MODEL=qwen/qwen3.8-27b
